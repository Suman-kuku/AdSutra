# ---------------------------------------------------------------------------
# Backend — backend/.env
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://gbkvfsmdzaegvhjefngb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Frontend — frontend/.env
# Only VITE_-prefixed vars reach the browser. Anon key only, never service role.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://gbkvfsmdzaegvhjefngb.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# LLM gateway — backend/.env
# OpenAI-compatible LiteLLM proxy. Model must be on your team's allowed list.
# ---------------------------------------------------------------------------
LITELLM_API_KEY=
LITELLM_BASE_URL=https://aiadda.kukufm.com/api/litellm/v1
LITELLM_MODEL=deepinfra/deepseek-ai/DeepSeek-V4-Pro
# Intent classifier (routes CREATE / EDIT / QUESTION) — can be a cheaper/faster model.
CLASSIFIER_MODEL=deepinfra/deepseek-ai/DeepSeek-V4-Pro
